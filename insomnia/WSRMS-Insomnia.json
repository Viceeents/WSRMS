      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"parcelId\": \"{{ _.parcel_id }}\",\n  \"type\": \"dispatch\",\n  \"quantity\": 2,\n  \"recipient\": \"Example Client\"\n}"
      }
