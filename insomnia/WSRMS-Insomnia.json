      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }],
      "body": {}
    },
    {
      "_id": "req_wsrms_create_parcel",
      "_type": "request",
      "parentId": "wrk_wsrms_api",
      "name": "Create parcel",
      "method": "POST",
      "url": "{{ _.base_url }}/api/inventory",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ _.token }}" },
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"parcelCode\": \"PKG-TEST-0001\",\n  \"company\": \"Example Supplier\",\n  \"storageLocation\": \"Rack A-01\",\n  \"quantity\": 12,\n  \"reorderThreshold\": 3,\n  \"fragile\": false\n}"
      }
    },
    {
      "_id": "req_wsrms_transactions",
      "_type": "request",
      "parentId": "wrk_wsrms_api",
      "name": "List transactions",
      "method": "GET",
      "url": "{{ _.base_url }}/api/transactions",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ _.token }}" }],
      "body": {}
    },
    {
      "_id": "req_wsrms_check_in",
      "_type": "request",
      "parentId": "wrk_wsrms_api",
      "name": "Check in parcel",
      "method": "POST",
