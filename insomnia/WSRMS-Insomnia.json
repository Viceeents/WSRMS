    {
      "_id": "req_wsrms_login",
      "_type": "request",
      "parentId": "wrk_wsrms_api",
      "name": "Sign in",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"vince@wsrms.local\",\n  \"password\": \"ENTER_YOUR_PASSWORD\"\n}"
      }
    },
    {
      "_id": "req_wsrms_request_access",
      "_type": "request",
      "parentId": "wrk_wsrms_api",
      "name": "Request access",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/request-access",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"fullName\": \"Warehouse Staff\",\n  \"email\": \"staff@example.com\",\n  \"password\": \"CHANGE_TO_A_STRONG_PASSWORD\"\n}"
      }
    },
    {
      "_id": "req_wsrms_inventory",
